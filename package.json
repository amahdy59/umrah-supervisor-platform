{
  "name": "umrah-supervisor-platform",
  "version": "1.0.0",
  "description": "Comprehensive platform for Umrah trip supervisors: logistics, pilgrims, ritual guidance, hotel/Haram best practices, and Gam'eya installment management.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "tsc -p tsconfig.build.json && vite build",
    "deploy": "wrangler pages deploy dist --project-name=umrah-supervisor"
  },
  "keywords": [
    "umrah",
    "hajj",
    "supervisor",
    "gameya",
    "installments",
    "pilgrim-guide",
    "tawaf-counter"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@types/qrcode-generator": "^0.0.16",
    "exceljs": "^4.4.0",
    "qrcode-generator": "^2.0.4"
  }
}
